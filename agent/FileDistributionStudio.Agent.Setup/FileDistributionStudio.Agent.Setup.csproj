<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>FileDistributionStudio.Agent</AssemblyName>
    <RootNamespace>FileDistributionStudio.Agent.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(AgentPayload)' != ''">
    <EmbeddedResource Include="$(AgentPayload)" LogicalName="FDS.Agent.Payload.exe" />
  </ItemGroup>
</Project>
