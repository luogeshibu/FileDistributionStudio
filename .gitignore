# ============================================================
# File Distribution Studio - Git ignore rules
# 目标：仓库只保留源代码、脚本、资源和文档；不提交本机环境、运行数据、
#      凭据/密钥、日志、缓存、构建结果和临时文件。
# ============================================================

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Packaging / build outputs ---
build/
dist/
release/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
*.whl

# Generated installers / archives / binaries
*.exe
*.msi
*.msix
*.zip
*.7z
*.rar

# NOTE: packaging/windows/FileDistributionStudio.spec is source and IS committed.

# --- Runtime data generated by File Distribution Studio ---
# Normal Windows runtime data lives under:
#   %LOCALAPPDATA%\FileDistributionStudio\
# These rules also protect the repo if a local/fallback path is used.
.file_distribution_studio/
FileDistributionStudioData/
cache/
logs/
audit/
staging/
downloads/
.fds_tmp/

fds.db
*.db
*.sqlite
*.sqlite3
settings.json
*.log
*.log.*
*.jsonl

# --- Credentials / secrets / machine-local configuration ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
credentials.json
credentials.*.json
secrets.json
secrets.*.json

# Real host inventories should stay local; keep only the repository sample.
hosts.csv
hosts_*.csv
targets.csv
targets_*.csv
!sample_hosts.csv

# --- Temporary / backup files ---
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo
*~
~$*

# --- IDE / editor files ---
.vscode/
.idea/
*.code-workspace
*.sublime-workspace
*.sublime-project

# --- OS metadata ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Local test/output scratch areas ---
tmp/
temp/
out/
output/
artifacts/

# Keep all checked-in source resources/documentation by default.
